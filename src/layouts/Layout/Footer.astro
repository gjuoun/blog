---
import { Icon } from "astro-icon/components";

const lang = (Astro.currentLocale || "en") as "en" | "zh";

const socials = [
  {
    name: "github",
    href: "https://github.com/gjuoun",
  },
  {
    name: "linkedin",
    href: "https://www.linkedin.com/in/gjuoun/",
  },
];

const basePathname = Astro.url.pathname.replace(/^\/zh/, "");
const switchLangHref = lang === "en" ? `/zh${basePathname}` : basePathname;
---

<div id="footer" class="bg-white dark:bg-gray-900 rounded-t-xl shadow-lg">
  <div class="py-4">
    <div class="grid grid-flow-col auto-cols-max justify-center items-center gap-6">
      <div class="grid grid-flow-col gap-1 items-center">
        {
          lang === "en" ? (
            <>
              <span class="text-primary font-semibold">EN</span>
              <span>|</span>
              <a href={switchLangHref} class="hover:text-primary">
                <span>中文</span>
              </a>
            </>
          ) : (
            <>
              <a href={switchLangHref} class="hover:text-primary">
                <span>EN</span>
              </a>
              <span>|</span>
              <span class="text-primary font-semibold">中文</span>
            </>
          )
        }
      </div>
      <button class="dark:text-amber-400 text-primary" id="theme-toggle" aria-label="Toggle theme">
        <Icon name="theme-dark" class="w-6 h-6 dark:hidden" />
        <Icon name="theme-light" class="w-6 h-6 hidden dark:block" />
      </button>
      {
        socials.map((social) => (
          <a href={social.href} target="_blank" rel="noopener noreferrer" class="hover:text-primary">
            <Icon name={social.name} class="w-6 h-6" />
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const themeToggle = document.getElementById('theme-toggle');
  if (!themeToggle) return;

  function toggleTheme() {
    const isDark = document.documentElement.classList.contains("dark");
    document.documentElement.classList.toggle("dark", !isDark);
    localStorage.setItem("theme", isDark ? "light" : "dark");
  }

  themeToggle.addEventListener('click', (e) => {
    e.preventDefault();
    toggleTheme();
  });
});
</script>
