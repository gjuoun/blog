---
import clsx from "clsx";

const getTagColor = (tag: string) => {
	const colors: Record<string, string> = {
		TypeScript: "bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300",
		JavaScript:
			"bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300",
		Rust: "bg-orange-100 text-orange-700 dark:bg-orange-900 dark:text-orange-300",
		Python: "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300",
	};

	return (
		colors[tag] ||
		"bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300"
	);
};

export interface Props {
	name: string;
	description: string;
	url: string;
	tags?: string[];
	class?: string;
}

const {
	name,
	description,
	url,
	tags = [],
	class: className = "",
} = Astro.props as Props;
---

<div class={clsx("rounded-xl p-6 bg-white dark:bg-gray-900 shadow-gray-100 shadow-md dark:shadow-gray-800", className)}>
  <a href={url} target="_blank" rel="noopener noreferrer" class="text-lg font-semibold mb-2 inline-block hover:text-blue-600 dark:hover:text-blue-400 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded">
    {name}
  </a>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-3 min-h-[4.5rem] line-clamp-3">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1">
      {tags.map((tag) => (
        <span class={clsx("text-xs px-2 py-1 rounded", getTagColor(tag))}>
          {tag}
        </span>
      ))}
    </div>
  )}
</div>
