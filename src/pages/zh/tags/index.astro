---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from "astro/virtual-modules/i18n.js";
import Card from "../../../components/Card.astro";
import Layout from "../../../layouts/Layout.astro";

const blogEntries = await getCollection('blog', ({ id }) => {
  return id.startsWith('zh/');
});

const lang = (Astro.currentLocale || "zh") as "en" | "zh";
const tags = [...new Set(blogEntries.flatMap((entry) => entry.data.tags).filter(Boolean))];

console.log(tags);
---

<Layout title="Tags" description="Tags" author="Jun Guo">
  <Card id="tags-container" prose>
    <h1 class="text-2xl font-bold">标签</h1>
    <div class="flex flex-wrap gap-2">
      {
        tags.map((tag) => (
          <a href={getRelativeLocaleUrl(lang, `/tags/${tag}`)}>{tag}</a>
        ))
      }
    </div>
  </Card>
</Layout>
